#include "desktop_version.h"
1 24 "gui.manifest"
101 ICON "handmadebt.ico"
1 VERSIONINFO
FILEVERSION HBT_VERSION_TUPLE
PRODUCTVERSION HBT_VERSION_TUPLE
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "HandmadeBT Download Manager"
   VALUE "FileVersion", HBT_VERSION_STRING
   VALUE "InternalName", "HandmadeBT"
   VALUE "OriginalFilename", "HandmadeBT.exe"
   VALUE "ProductName", "HandmadeBT"
   VALUE "ProductVersion", HBT_VERSION_STRING
   VALUE "LegalCopyright", "GPL-2.0-or-later; see COPYING"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
