{
  "manifest_version": 3,
  "name": "HandmadeBT 下载助手",
  "version": "0.9.7",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "description": "将浏览器下载链接交给 HandmadeBT 桌面客户端。"
}
